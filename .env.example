# Google Gemini (free tier works) — get key at https://aistudio.google.com/apikey
# Paste the key exactly as copied (starts with AQ. or AIza). Do NOT add sk-proj- in front.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Notion API for private workspace pages (https://www.notion.so/myintegrations)
# NOTION_API_KEY=secret_...
# Then connect the integration to your page in Notion (⋯ → Connections).

# Optional: OpenAI instead (starts with sk-)
# OPENAI_API_KEY=sk-your-openai-key-here
